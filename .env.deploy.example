# Hostname only. Use localhost for a closed local rehearsal and a DNS name on the VPS.
DEPLOY_DOMAIN=localhost
DEPLOY_BIND_ADDRESS=127.0.0.1

# Set each to a separate, strong secret before starting the stack.
DEPLOY_MYSQL_ROOT_PASSWORD=
DEPLOY_FLYWAY_PASSWORD=
DEPLOY_DB_PASSWORD=
DEPLOY_JWT_SECRET=

# Optional, separate backend-only file for provider credentials.
# BACKEND_INTEGRATIONS_ENV_FILE=./deploy/.env
