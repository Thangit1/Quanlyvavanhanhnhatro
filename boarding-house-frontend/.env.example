NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=SmartHome AI

# Vercel optional first-party cookie proxy; rebuild/redeploy after changing NEXT_PUBLIC_*.
# NEXT_PUBLIC_API_BASE_URL=/api/backend
# AUTH_PROXY_BACKEND_URL=https://your-backend-host/api
# AUTH_PROXY_COOKIE_NAME=refresh_token
# AUTH_PROXY_* are server-only; never put SMTP credentials in NEXT_PUBLIC_* variables.
