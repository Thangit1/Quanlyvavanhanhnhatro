MYSQL_DATABASE=boarding_house_management
MYSQL_ROOT_PASSWORD=change_me
MYSQL_PORT=3306

DB_URL=jdbc:mysql://localhost:3306/boarding_house_management?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# Optional separate Flyway migration account; runtime keeps DB_USERNAME/DB_PASSWORD.
# Required for trigger migrations when the runtime account lacks DBA privileges.
# FLYWAY_USERNAME=your_migration_admin
# FLYWAY_PASSWORD=your_migration_admin_password

JWT_SECRET=change_me_with_at_least_32_random_characters
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

FRONTEND_URL=http://localhost:3000
# Public frontend address used in contract and one-time activation emails.
# Configure HTTPS on deployed environments; independent of the CORS allow-list above.
FRONTEND_PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Deployed direct cross-site: COOKIE_SECURE=true, COOKIE_SAME_SITE=None.
# FRONTEND_URL is an exact comma-separated CORS origin list (no trailing slash/wildcard).
# Explicit cloudflared peer IPs ONLY when the backend cannot be reached bypassing the tunnel.
# Empty is safe: shared tunnel/proxy IP is rate-limited conservatively.
TRUSTED_CLOUDFLARE_PROXIES=
# Recovery is a separate explicit opt-in for SYSTEM SMTP (not owner Integration Center SMTP).
PASSWORD_RECOVERY_ENABLED=false
PASSWORD_RECOVERY_EMAIL_LIMIT=3
PASSWORD_RECOVERY_IP_LIMIT=20
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900000
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=60000

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=

NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_APP_NAME=SmartHome AI
# Optional Vercel same-origin proxy for browsers blocking third-party cookies:
# NEXT_PUBLIC_API_BASE_URL=/api/backend
# AUTH_PROXY_BACKEND_URL=https://your-backend-host/api
# AUTH_PROXY_COOKIE_NAME=refresh_token
# AUTH_PROXY_* are server-only Vercel variables. Redeploy after changing NEXT_PUBLIC_*.

# Optional local development image directory, outside this repository.
# Production: set PROPERTY_IMAGE_ROOT to an absolute persistent mounted volume.
# PROPERTY_IMAGE_ROOT=/var/lib/smarthome/property-images

# Prompt 15: backend only; NEVER prefix credentials with NEXT_PUBLIC_.
# Generate 32 random bytes, base64 encode, store outside git. Keep stable across restarts.
INTEGRATION_MASTER_KEY=
# Explicit SMTP host and test recipient allowlists (comma separated).
INTEGRATION_SMTP_HOSTS=smtp.gmail.com,smtp.office365.com,smtp.mail.yahoo.com
INTEGRATION_TEST_RECIPIENTS=
INTEGRATION_ALLOW_LOCAL_SMTP=false
INTEGRATION_ZALO_TEST_UIDS=
INTEGRATION_ZALO_LIVE_TEST=false
# Optional server-only credentials scoped by actual owner ID. Configure metadata in UI.
# INTEGRATION_1_EMAIL_PASSWORD=
# INTEGRATION_1_ZALO_APP_SECRET=
# INTEGRATION_1_ZALO_OA_SECRET=
# INTEGRATION_1_ZALO_ACCESS_TOKEN=
# INTEGRATION_1_ZALO_REFRESH_TOKEN=
# INTEGRATION_1_WEB_PUSH_PRIVATE_KEY=
# INTEGRATION_1_PAYMENT_VNPAY_HASH_KEY=
# INTEGRATION_1_PAYMENT_MOMO_ACCESS_KEY=
# INTEGRATION_1_PAYMENT_MOMO_SECRET_KEY=
# INTEGRATION_1_AI_API_KEY=

# Gmail SMTP for the local Spring Mail profile. Set real values in your terminal only.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_TEST_RECIPIENT=
# MAIL_FROM=  # optional verified sender; defaults to MAIL_USERNAME
# MAIL_FROM_NAME=SmartHome AI
# MAIL_BUSINESS_DELIVERY_ENABLED=false
# SPRING_MAIL_HOST=smtp.your-provider.example
# SPRING_MAIL_PORT=587
# Recovery uses PASSWORD_RECOVERY_ENABLED independently of business email opt-in.
# MAIL_TEST_RECIPIENT restricts recovery delivery to that single address when non-empty.
# MAIL_SMOKE_TEST=true  # explicit consent for one email per smoke-test invocation

# Payment module: local simulation only; prod always rejects simulator requests.
# PAYMENT_SIMULATION_ENABLED=false
# VIETQR_TEMPLATE=your_custom_template
# Merchant credentials are server-only and scoped by the actual owner ID (replace 1).
# Use the INTEGRATION_1_PAYMENT_* variable examples above with your actual owner ID.
# VNPAY_ENABLED/VNPAY_HASH_SECRET and MOMO_ENABLED/MOMO_SECRET_KEY are not consumed.
# Enable each gateway in the owner's Integration Center after configuring its scoped keys and URLs.
